<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Wi-Fi machine password (car_wifi.xml) and activation token from computer (headswap_activation.xml) do not go to the cloud backup, nor when transferred to another device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="car_wifi.xml" />
        <exclude domain="sharedpref" path="headswap_activation.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="car_wifi.xml" />
        <exclude domain="sharedpref" path="headswap_activation.xml" />
    </device-transfer>
</data-extraction-rules>
