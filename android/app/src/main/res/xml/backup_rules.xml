<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11: Wi-Fi machine password (car_wifi.xml) and activation token from computer (headswap_activation.xml) do not go to cloud backup; rest as default -->
<full-backup-content>
    <exclude domain="sharedpref" path="car_wifi.xml" />
    <exclude domain="sharedpref" path="headswap_activation.xml" />
</full-backup-content>
