<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subject follows system (DayNight); colors are taken from values/colors.xml and values-night/colors.xml -->
    <style name="Theme.Headswap" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/acc</item>
        <item name="android:colorControlActivated">@color/acc</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/on</item>
        <item name="android:textColorSecondary">@color/on2</item>
        <item name="android:textColor">@color/on</item>
        <item name="android:fontFamily">@font/golos</item>
        <item name="android:alertDialogTheme">@style/Theme.Headswap.Dialog</item>
    </style>

    <!-- "Medium" theme: MainActivity boosts uiMode night (AppTheme.wrap), colors are replaced by *_mid -->
    <style name="Theme.Headswap.Medium" parent="Theme.Headswap">
        <item name="android:windowBackground">@color/bg_mid</item>
        <item name="android:colorBackground">@color/bg_mid</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/acc_mid</item>
        <item name="android:colorControlActivated">@color/acc_mid</item>
        <item name="android:colorControlHighlight">@color/ripple_mid</item>
        <item name="android:textColorPrimary">@color/on_mid</item>
        <item name="android:textColorSecondary">@color/on2_mid</item>
        <item name="android:textColor">@color/on_mid</item>
    </style>

    <!-- Home desktop screen (virtual display head unit): always dark, without ActionBar -->
    <style name="Theme.Headswap.Desktop" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#10151E</item>
        <item name="android:colorBackground">#10151E</item>
        <item name="android:colorAccent">#F2B33D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/golos</item>
    </style>

    <!-- Keep the dialog dark with its own accent/text colors; otherwise dark @color/acc and @color/on values leak from the light app theme and make its title/buttons blend into the background. -->
    <style name="Theme.Headswap.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/acc_dlg</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@font/golos</item>
    </style>
</resources>
