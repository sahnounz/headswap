<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="true" />
    <!-- selection of the machine (auto-start of wireless by Bluetooth); without CDM application works, only without binding -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- calls and call log for the launcher phone card; without telephony (tablet) the application is placed, the card is empty -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- AA-mode: TCP on loopback to server head unit Android Auto (127.0.0.1:5277) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- one of the conditions for foreground-connectedDevice service; the usual permission is issued upon installation -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Wi-Fi machines (WifiNetworkSpecifier) and STA+STA feature; normal permits, issued upon installation -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- which Wi-Fi interfaces are occupied by the client phone, and which hotspot (h420); normal resolution -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 17 (targetSdk 37): local area network (incoming TCP wireless CarLife, UDP-beacon 7999/8999, mDNS-port search
         debugging by Wi-Fi when activated from your phone). Loopback (AA 5277, debug, adbd of your phone) does not require. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- wireless, A branch (diagnostics): RFCOMM-carlife server, head unit connects itself; old resolutions up to Android 11 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- wireless, A: branch entry Wi-Fi Direct-group head unit (WifiP2pManager.connect); up to Android 13 instead geolocation -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- Android 12: request one FINE without COARSE system silently rejects -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <!-- tying the machine through CompanionDeviceManager: exceptions to running foreground-service and working in the background; normal permissions -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- Phone microphone as a backup sound source for the AA (auto/phone mode) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- h428: call status for head unit (MODULE_STATUS PHONE/TELE_STATE) as Baidu -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- "Phone" card launcher Headswap Desktop: call log, contacts, call and response from the screen head unit; regular runtime-resolutions,
         requested by the button in the Mode / Desktop section -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- onboarding: Exclusion Request from Battery Optimization (HyperOS Kills Background) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- update from app: installation downloaded from GitHub APK via PackageInstaller -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- without queries on API 30+ package Android Auto is not visible (installation check, settings start) -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- "Magnetola applications" section: installation status and directory start (Fermata Auto, ParkedTube, AABrowser) -->
        <package android:name="me.aap.fermata.auto.dear.google.why" />
        <package android:name="dev.codex.aaparkedyoutube" />
        <package android:name="com.kododake.aabrowser" />
        <!-- search for any applications for Android Auto: players (service) and full-screen (activity) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.CAR_LAUNCHER" />
        </intent>
        <!-- Desktop with computer activation: list and check running applications for built-in windows -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- launcher Headswap Desktop: third-party desktop selection (DriveDeck, CarDash) - entries under HOME; LAUNCHER above -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- launcher Headswap Desktop: music player list (MediaBrowserService) for switch on music card -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- Only explicit activation from computer (adb shell -> am instrument with token from application).
         The target is the main application process, not :delegated. Token is checked before issuing any rights.
         Full name: AGP does not reveal the relative name in instrumentation, but in assembly .smoke it
         would be allowed from applicationId, not from namespace. -->
    <instrumentation
        android:name="com.yegorkapomidorka.headswap.dex.DelegatedDesktopInstrumentation"
        android:targetPackage="${applicationId}"
        android:functionalTest="true"
        android:handleProfiling="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name=".HeadswapApp"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.Headswap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!-- distribution of logs and reports through "Share" (read only, without AndroidX FileProvider) -->
        <provider
            android:name=".ui.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Home screen Headswap Desktop (launcher on Compose): it runs :delegated (the same uid) on the virtual display head unit,
             there is no need outside; the phone does not become a home application. launchMode as the fork is not specified (standard). -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.desktop"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Headswap.Desktop" />

        <!-- the "Stop" button in the notification -->
        <receiver
            android:name=".ui.StopReceiver"
            android:exported="false" />

        <!-- autostart wireless: ACL selected machine; off until machine is selected (CarProfile.enableTrigger) -->
        <receiver
            android:name=".link.car.CarAclReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Update Installation Status (PackageInstaller) -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- microphone: only for phone microphone capture time (fallback AA-microphone); type in runtime selects service -->
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- activation of Headswap Desktop from the phone itself: pairing with debugging by Wi-Fi, code is entered in the notification -->
        <service
            android:name=".dex.PhoneActivationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- manufacturer of the desktop (virtual screen) in a separate process: its death does not terminate the activation in the main -->
        <service
            android:name=".dex.DelegatedDesktopService"
            android:exported="false"
            android:process=":delegated" />
    </application>
</manifest>
